<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:ErpSample.Common">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <common:NullToVisibilityConverter x:Key="NullToVisibility"/>

    <!--
        Every TextBox in the app picks this up automatically - no per-field XAML needed
        to get the red-border behavior. We replace the default Validation.ErrorTemplate
        (which draws a red adorner box WPF manages itself) with a plain placeholder,
        because the design calls for an inline message below the field instead of a
        floating red box - see the ErrorMessage TextBlocks in InvoiceDetailForm.xaml.
    -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderBrush" Value="#BBBBBB"/>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="#D64545"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="#D64545"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Reusable style for the inline "message below the field" error text -->
    <Style x:Key="FieldErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D64545"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>

</ResourceDictionary>
