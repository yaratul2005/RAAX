<UserControl x:Class="ErpSample.Views.InvoiceModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ErpSample.Views"
             xmlns:inv="clr-namespace:ErpSample.Modules.Invoicing">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ValidationStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type inv:InvoiceDetailViewModel}">
                <views:InvoiceDetailForm/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" DataContext="{Binding ListViewModel}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8">
                <Button Content="New Record" Command="{Binding NewCommand}" Margin="0,0,6,0"/>
                <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,6,0"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,0"/>
                <TextBox Width="180" Margin="12,0,0,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #" Width="100" Binding="{Binding InvoiceNumber}"/>
                    <DataGridTextColumn Header="Customer" Width="*" Binding="{Binding CustomerName}"/>
                    <DataGridTextColumn Header="Date" Width="100" Binding="{Binding InvoiceDate, StringFormat=d}"/>
                    <DataGridTextColumn Header="Total Amount" Width="110" Binding="{Binding Total, StringFormat=C}"/>
                    <DataGridTextColumn Header="Status" Width="100" Binding="{Binding Status}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Width="400" Padding="12"
                BorderThickness="1,0,0,0" BorderBrush="#27272a"
                Visibility="{Binding DetailViewModel, Converter={StaticResource NullToVisibility}}">
            <ContentControl Content="{Binding DetailViewModel}"/>
        </Border>
    </Grid>
</UserControl>
