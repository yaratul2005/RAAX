<UserControl x:Class="ErpSample.Views.InvoiceDetailForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="4">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBlock Text="Customer Name"/>
        <TextBox x:Name="TxtCustomer"
                 Text="{Binding Item.CustomerName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,2,0,0"/>
        <TextBlock Style="{StaticResource FieldErrorText}"
                   Text="{Binding ElementName=TxtCustomer, Path=(Validation.Errors)[0].ErrorContent}"
                   Visibility="{Binding ElementName=TxtCustomer, Path=(Validation.HasError),
                                Converter={StaticResource BoolToVisibility}}"/>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Invoice Date"/>
                <DatePicker SelectedDate="{Binding Item.InvoiceDate}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Due Date"/>
                <DatePicker x:Name="DpDueDate" SelectedDate="{Binding Item.DueDate}"/>
                <TextBlock Style="{StaticResource FieldErrorText}"
                           Text="{Binding ElementName=DpDueDate, Path=(Validation.Errors)[0].ErrorContent}"
                           Visibility="{Binding ElementName=DpDueDate, Path=(Validation.HasError),
                                        Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Transaction Line Items" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <DataGrid x:Name="GridLines"
                  ItemsSource="{Binding Item.Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Height="160">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item SKU" Width="*"
                                     Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Quantity" Width="60"
                                     Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Rate (BDT)" Width="90"
                                     Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Amount (BDT)" Width="100" IsReadOnly="True"
                                     Binding="{Binding Amount, StringFormat=C}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="+ Add Line" Command="{Binding AddLineCommand}"/>
            <Button Content="Remove Line" Margin="6,0,0,0"
                    Command="{Binding RemoveLineCommand}"
                    CommandParameter="{Binding ElementName=GridLines, Path=SelectedItem}"/>
        </StackPanel>

        <TextBlock Text="{Binding Item.Total, StringFormat='Total Amount: {0:C}'}"
                   FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,12,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0"/>
            <Button Content="Save &amp; Post" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
